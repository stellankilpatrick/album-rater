# Copy to .env.local for local development (see README "One-time setup")

JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d

# Local Postgres only; never the production (Neon) URL
# macOS:   postgres://localhost:5432/album_rater_dev
# Windows: postgres://postgres:YOUR_PASSWORD@localhost:5432/album_rater_dev
DATABASE_URL=postgres://localhost:5432/album_rater_dev

# Optional comma-separated CORS whitelist; leave unset locally to allow all origins
# FRONTEND_URLS=http://localhost:3001

# Email (SMTP) settings - use your provider's credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From address for outgoing mail
EMAIL_FROM="Album Rater <no-reply@yourdomain.com>"

# Public app url used to build reset links (include scheme)
APP_URL=http://localhost:3001
